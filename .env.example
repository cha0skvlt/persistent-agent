# Agent Core — environment template (same keys/sections as local .env).
# Copy: cp .env.example .env
# No quotes around values (pydantic-settings).
# Secrets: leave empty or use placeholders below.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/agent_db
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_CHECKPOINT_POOL_MIN=1
DB_CHECKPOINT_POOL_MAX=3
CHECKPOINTER=postgres
CHECKPOINT_AUTO_REPAIR=0
CHECKPOINT_AUTO_REPAIR_CONFIRM=0

# ── Providers ─────────────────────────────────────────────────────────────────
# Chat and embeddings are independent channels.
#   ollama — local Ollama (default)
#   openai — any OpenAI-compatible server: vLLM, OpenAI, OpenRouter, Together, LM Studio
# LLM_BASE_URL empty = OLLAMA_BASE_URL for ollama; required for openai.
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_API_KEY=
# JSON merged into the request body for OpenAI-compatible servers.
# vLLM example: {"top_k": 40, "min_p": 0.0}
LLM_EXTRA_BODY=
EMBED_PROVIDER=ollama
EMBED_BASE_URL=
EMBED_API_KEY=
# Must match the vector(N) columns. Changing it on an existing DB needs a reindex.
EMBED_DIM=768

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# -1 / -1m = never unload (resident model)
LLM_KEEP_ALIVE=30m

# ── Boot ──────────────────────────────────────────────────────────────────────
# Retry loop for API lifespan (waits for Ollama/Postgres after reboot).
BOOT_RETRY_ATTEMPTS=30
BOOT_RETRY_SLEEP_SEC=10

# ── Models ────────────────────────────────────────────────────────────────────
# Single chat model for agent and background jobs.
# Any Ollama tag works; the default is a small local model. Larger tags need more VRAM.
REASONING_MODEL=qwen3:8b

LLM_NUM_CTX=32768
# Shared Ollama num_predict: thinking + visible reply. Raise for longer answers
# after long thinking (too low → done_reason=length, empty/mid-cut reply).
LLM_NUM_PREDICT=8192
# Native Ollama thinking mode (reasoning=True). Disable for models without thinking.
LLM_REASONING=1
# Native Ollama tool calling. Disable for models without tool support;
# agent falls back to HTC recovery (hallucinated-tool-call JSON in content).
LLM_SUPPORTS_TOOLS=1

# ── Embeddings ────────────────────────────────────────────────────────────────
# Ollama: nomic-embed-text-v2-moe (768-d). OpenAI: text-embedding-3-small (1536-d).
# vLLM: any served embedding model, e.g. BAAI/bge-base-en-v1.5 (768-d).
# Reindex after switching models or dimensions.
EMBED_MODEL=nomic-embed-text-v2-moe

# ── Agent / LangGraph ─────────────────────────────────────────────────────────
DEFAULT_AGENT_ID=agent
LANGGRAPH_THREAD_ID=main_session_v1
RECURSION_LIMIT=100
MAX_TOOL_ROUNDS_PER_TURN=30
# Loop budget: the tool loop stops on stalling, not on length.
LOOP_WALL_CLOCK_SECONDS=240
LOOP_STALL_REPEAT_THRESHOLD=2
LOOP_STALL_FRUITLESS_ROUNDS=3
# Background tool-round *base* cap (not max(live, this)). 0 = use MAX_TOOL_ROUNDS_PER_TURN.
REVERIE_MAX_TOOL_ROUNDS=15
CHECKPOINT_MAX_MESSAGES=48
TOOL_COLLAPSE_KEEP_RECENT_PAIRS=12
CONVERSATION_SNAPSHOT_MAX_MESSAGES=4000
CONVERSATION_SNAPSHOT_EVERY_N=3
CONTEXT_WINDOW_MESSAGES=48
# Prompt token estimate (context_budget): chars-per-token; lower = more conservative.
TOKEN_EST_CPT_LATIN=3.4
TOKEN_EST_CPT_CYRILLIC=2.0
SYS_MEM_MAX_CHARS=4000
SYS_SUMMARY_MAX_CHARS=2000
SYS_MIND_MAX_CHARS=2400
SYS_DIARY_MAX_CHARS=2000
# Live agent turns share one GPU slot.
LLM_MAX_CONCURRENT_TURNS=1

# ── Memory ────────────────────────────────────────────────────────────────────
MEMORY_DEDUP_COSINE=0.92
MEMORY_DEDUP_NEIGHBORS=5
MEMORY_DEDUP_FUZZY_COSINE=0.85
MEMORY_DEDUP_TEXT_OVERLAP=0.8
MEMORY_DEDUP_BASE_IMPORTANCE=0.5
MEMORY_IMPORTANCE_CAP=1.0
MEMORY_SEARCH_ANN_CANDIDATES=50
MEMORY_TTL_DAYS=365
MEMORY_FORGET_MIN_IMPORTANCE=0.1

# ── Retrieval rerank ──────────────────────────────────────────────────────────
MEMORY_RETRIEVE_TOP_K=3
MEMORY_SIMILARITY_FLOOR=0.3
# Retrieve distrust: [MEM] is evidence, not oracle truth
MEMORY_DISTRUST_ENABLED=1
MEMORY_RETRIEVE_TYPES=semantic,unverified
MEMORY_UNVERIFIED_RERANK_FACTOR=0.35
MEMORY_AGE_HALF_LIFE_DAYS=180
MEMORY_CONTRADICTION_IMPORTANCE_FACTOR=0.7
LESSON_RETRIEVE_TOP_K=2
SELF_REFLECTION_RETRIEVE_TOP_K=4
DIARY_ECHO_CHECK_N=20
DIARY_ECHO_THRESHOLD=0.92

# ── Reflect consistency gate (DB-only; not a truth oracle) ────────────────────
# save_memory tool + deferred reflect world-facts; deferred diary writes.
# Compares new text vs existing DB rows (similarity + light polarity heuristic).
# Off by default: polarity heuristic too weak; echo gate + distill keep hygiene.
REFLECT_CONSISTENCY_GATE_ENABLED=0
REFLECT_CONSISTENCY_GATE_TOP_K=5
# Optional; unset = derived from MEMORY_SIMILARITY_FLOOR (see ARCHITECTURE §23.1)
REFLECT_CONSISTENCY_GATE_SIM_THRESHOLD=
MEMORY_CONTRADICTION_POLICY=log

# ── Session summary ───────────────────────────────────────────────────────────
SUMMARY_EVERY_N=20
SUMMARY_MAX_CHARS=1500
SUMMARY_LLM_MAX_MESSAGES=80
SUMMARY_LLM_MAX_MESSAGES_FORCE=24
SUMMARY_DEFER=1

# ── Reflection ────────────────────────────────────────────────────────────────
REFLECTION=1
REFLECT_EVERY_N=5
REFLECT_DEFER=1
REFLECT_SKIP_SHORT_REPLY_CHARS=450
SELF_REFLECT_EVERY_N=10

# ── Role review (offline DPO gold pairs) ─────────────────────────────
# Off by default — second critic pass. Set 1 only with migrated dpo_gold_pairs.
ROLE_REVIEW=0
ROLE_REVIEW_EVERY_N=3
ROLE_REVIEW_MIN_REPLY_CHARS=40

# ── Knowledge graph ───────────────────────────────────────────────────────────
KG_ENTITY_RESOLVE_THRESHOLD=0.90
KG_FIND_RELATED_LIMIT=30

# ── Vitals ────────────────────────────────────────────────────────────────────
# dev = local REPL without heart; strict = production with signed heart ticks
VITALS_TRUST_MODE=dev

# ── Identity ──────────────────────────────────────────────────────────────────
SIGN_RESPONSES=0

# ── Solitary / reverie (background self-reflection) ─────────────────
SOLITARY_ENABLED=0
SOLITARY_INTERVAL_MIN=5
REVERIE_LOOP_MIN_SEC=30

# ── Outreach (proactive Telegram messages) ─────────────────────────
# No cooldown / dedup / idle gate — whether and how often to write is the
# agent's own decision (message_user). OUTREACH_ENABLED is the only kill switch.
OUTREACH_ENABLED=0
# Wait for solitary/intent to stamp → turn footer before Heart sends (0 = no wait).
OUTREACH_FOOTER_GRACE_SEC=90
# Max pending outbox rows; message_user refuses above this (anti-spam).
OUTREACH_QUEUE_MAX=8
# Diary memory hygiene only (near-duplicate reflections) — never gates outreach.
NOVELTY_COSINE_THRESHOLD=0.88

# Optional rhythm alias (empty = use SOLITARY_INTERVAL_MIN)
RHYTHM_SOLITARY_INTERVAL_MIN=

# ── Mind Hub (cross-channel continuity) ───────────────────────────────────────
MIND_HUB_ENABLED=1
MIND_HUB_MAX_EVENTS=12

# ── Pulse (scheduled intentions) ────────────────────────────────────
PULSE_ENABLED=1
INTENTS_MAX_PENDING=20
INTENTS_MAX_PER_DAY=10
INTENTS_RUNNING_TTL_MIN=30
PULSE_SYS_MAX_CHARS=600

# ── Web tools ─────────────────────────────────────────────────────────────────
WEB_FETCH_ENABLED=1
WEB_SEARCH_ENABLED=1
WEB_FETCH_TIMEOUT_SEC=25
WEB_FETCH_MAX_BYTES=1500000
WEB_FETCH_MAX_CHARS=28000
WEB_FETCH_RENDER_FALLBACK=1
WEB_FETCH_RENDER_MIN_CHARS=200
WEB_EVIDENCE_MAX_CHARS=4500
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_RETRIES=3
# Circuit breaker on the search backend chain (live turn holds the LLM semaphore)
WEB_SEARCH_TOTAL_BUDGET_SEC=20
WEB_BACKEND_FAIL_THRESHOLD=3
WEB_BACKEND_COOLDOWN_SEC=120
WEB_SEARCH_QUERY_MAX_CHARS=160
WEB_SEARCH_REGION=wt-wt
WEB_SEARCH_USER_AGENT=
WEB_SEARCH_PREFETCH_ON_INTENT=1
WEB_SKIP_MEMORY_ON_INTENT=0
WEB_USER_AGENT=PersistentAgent-Agent/1.0 (compatible; research bot)
# Bare-metal SearXNG (primary search_web). LaunchAgent: ai.piniq.searxng
# Operator also sets SEARXNG_SETTINGS_PATH / SEARXNG_SECRET for the LaunchAgent
# process env (not agent Settings fields). Secret never committed.
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_TIMEOUT_SEC=10
WEB_SEARCH_CACHE_TTL_SEC=86400
WEB_SEARCH_CACHE_PATH=
# search_web chain: searxng → ddgs → Playwright DDG SERP → Wikipedia.
# No Docker, no cloud SaaS, no paid search keys.
# Local Playwright browse_web (no cloud browser). Requires: playwright install chromium
WEB_BROWSE_ENABLED=1
WEB_BROWSE_TIMEOUT_SEC=30
WEB_BROWSE_MAX_STEPS=8
WEB_BROWSE_MAX_CHARS=28000
WEB_BROWSE_EXTRA_TOOL_ROUNDS=3

# ── Heart daemon (launchd) ────────────────────────────────────────────────────
HEART_INTERVAL_SEC=30
HEART_BACKUP_INTERVAL_SEC=21600
HEART_NOTIFY_CHAT_ID=
HEART_NOTIFY_COOLDOWN_SEC=600
HEART_DISK_ALERT_PCT=95
HEART_BATTERY_ALERT_PCT=5
HEART_OLLAMA_DOWN_ALERT_SEC=300
HEART_CHECK_API_ENABLED=1
HEART_API_HEALTH_URL=http://127.0.0.1:8080/health
HEART_API_FAIL_THRESHOLD=3
HEART_API_AUTO_RESTART=0
HEART_API_LAUNCHD_LABEL=
PHYLACTERY_BACKUP_DIR=~/Backups/agent
PHYLACTERY_MAX_BACKUPS=28
PHYLACTERY_RESTORE_DB=agent_db_restore

# ── Logging / environment ───────────────────────────────────────────────────
LOG_LEVEL=DEBUG
# Copytruncate rotation for agent-*.log (runs from heart tick)
LOG_ROTATE_MAX_MB=64
LOG_ROTATE_BACKUPS=2
AGENT_TZ=UTC
POSTGRES_SERVICE=postgresql@18
INSTALL_DEPS=0
ENVIRONMENT=dev
# Optional OTLP export (no in-repo collector). Default off.
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4318

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8080
API_KEY=
API_DEFAULT_THREAD_ID=api_session_v1
CLI_DEFAULT_THREAD_ID=cli_session_v1

# ── Telegram ──────────────────────────────────────────────────────────────────
# BREAKING (fail-closed): empty TELEGRAM_ALLOWED_CHAT_IDS denies ALL chats.
# Before deploy: set your numeric chat id (message @userinfobot or Bot API getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional fallback when allowlist is empty — owner chat only (polling won't start without one of these).
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_POLLING=1
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_THREAD_PREFIX=telegram
TELEGRAM_TYPING_INTERVAL_SEC=4
# Sleep/wake state file shared by API + Heart (/make sleep|wake). Empty = ~/.cache/persistent-agent/agent_mode.json
AGENT_MODE_PATH=
