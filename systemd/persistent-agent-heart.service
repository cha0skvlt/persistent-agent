[Unit]
Description=persistent-agent Heart (vitals, backup, outreach delivery)
Documentation=file://@REPO_ROOT@/ARCHITECTURE.md
After=network-online.target postgresql.service persistent-agent-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=PYTHONPATH=@REPO_ROOT@
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=@VENV_PYTHON@ -m src.heart.heartbeat
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
